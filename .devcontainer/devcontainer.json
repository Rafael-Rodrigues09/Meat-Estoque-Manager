{
  "name": "Meat-Estoque-Manager Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "username": "vscode"
    }
  },

  "forwardPorts": [8000, 8501],
  
  "portsAttributes": {
    "8000": {
      "label": "FastAPI Backend (API Docs)",
      "onAutoForward": "notify"
    },
    "8501": {
      "label": "Streamlit Frontend (UI)",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "editor.formatOnSave": true,
        "editor.tabSize": 4
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  },

  "postCreateCommand": "pip install --upgrade pip && pip install -r back-end/requirements.txt && pip install -r front-end/requirements.txt",

  "remoteUser": "vscode"
}